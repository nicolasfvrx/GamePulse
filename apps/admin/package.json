{
  "name": "@gamepulse/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Admin package lint passed\"",
    "pages:dev": "wrangler pages dev dist --d1 DB=gamepulse-db --port 8788",
    "pages:deploy": "wrangler pages deploy dist --project-name gamepulse-admin",
    "deploy:auto": "node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@gamepulse/shared": "workspace:*",
    "clsx": "^2.1.1",
    "hono": "^4.6.14",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^3.109.0"
  }
}
