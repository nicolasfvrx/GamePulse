{
  "name": "@gamepulse/shared",
  "version": "1.0.0",
  "description": "Shared TypeScript definitions and utilities for GamePulse Discord Presence Network",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
